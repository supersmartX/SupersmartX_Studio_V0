// SupersmartX Studio — PostgreSQL schema (Prisma).
//
// This file is a faithful model of the schema the application already runs on
// Turso/libSQL (src/lib/db/schema.ts, MIGRATION_LEDGER v1–v14). Table and column
// names are preserved verbatim via @@map/@map so the existing SQL and the data
// migration never have to translate identifiers.
//
// Rules for this file:
//  - Never rename an existing table or column to "tidy" it. Names are the wire
//    contract with src/lib/db/index.ts and the Turso→Postgres data copy.
//  - IDs are application-generated strings (crypto.randomUUID / prefixes).
//    Never switch them to Prisma-generated UUID/CUID.
//  - Money is Decimal, never Float.
//  - Timestamps are timestamptz (the app previously stored ISO-8601 TEXT and a
//    few SQLite `datetime('now')` values; see the H-1 note in the migration).
//  - Byte counts are BigInt: a single export may be 2 GiB (MAX_EXPORT_SIZE_MB =
//    2048), which is one byte over Postgres `integer`, and storage_bytes is
//    cumulative.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries go through the pooled connection (transaction pooler on
  // Supabase, port 6543). Schema commands (`prisma migrate`) require a direct,
  // session-mode connection and use DIRECT_URL (port 5432).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Application accounts. `plan`/`plan_expires_at` gate paid entitlements and
/// are written exactly once per payment (see processed_webhooks).
model User {
  id                  String    @id @db.Text
  email               String    @unique @db.Text
  name                String    @db.Text
  passwordHash        String    @map("password_hash") @db.Text
  createdAt           DateTime  @map("created_at") @db.Timestamptz(3)
  plan                String    @default("free") @db.Text
  planExpiresAt       DateTime? @map("plan_expires_at") @db.Timestamptz(3)
  // Account lockout (schema v6). Nullable in the original DDL; the write path
  // treats a missing row value as 0. Coalesced to 0 during data migration.
  failedLoginAttempts Int?      @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  // Password-reset invalidation counter (schema v8).
  sessionVersion      Int       @default(0) @map("session_version")

  userStats            UserStats?
  exports              Export[]
  exportJobs           ExportJob[]
  pendingOrders        PendingOrder[]
  monthlyExportCounts  MonthlyExportCount[]
  dailyRecordingSecond DailyRecordingSecond[]

  @@map("users")
}

/// Single-use password reset tokens. Not FK-linked to users (a token may be
/// issued before the account exists in the signup flow).
model ResetToken {
  tokenHash String   @id @map("token_hash") @db.Text
  email     String   @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([email])
  @@map("reset_tokens")
}

/// Runtime schema-version marker. Written by the legacy libSQL migration runner
/// (`src/lib/db/schema.ts`) and read by `/api/health`
/// (`SELECT value FROM schema_meta WHERE key='schema_version'`). Kept as a plain
/// table — NOT a schema authority; Prisma Migrate owns the schema. Preserved so
/// the existing health endpoint keeps working across the cutover.
model SchemaMeta {
  key   String @id @db.Text
  value String @db.Text

  @@map("schema_meta")
}

/// 1:1 per-user usage counters. Owned by the user (CASCADE on delete).
model UserStats {
  userId        String @id @map("user_id") @db.Text
  downloadCount Int    @default(0) @map("download_count")
  uploadCount   Int    @default(0) @map("upload_count")
  storageBytes  BigInt @default(0) @map("storage_bytes")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

/// A finished, downloadable export artifact. The R2 object key is stored here;
/// the bytes live in Cloudflare R2, never in the database.
model Export {
  id           String   @id @db.Text
  userId       String   @map("user_id") @db.Text
  r2Key        String   @map("r2_key") @db.Text
  platform     String   @db.Text
  outputWidth  Int      @map("output_width")
  outputHeight Int      @map("output_height")
  fileSize     BigInt   @default(0) @map("file_size")
  mimeType     String   @default("video/mp4") @map("mime_type") @db.Text
  status       String   @default("completed") @db.Text
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)
  jobId        String?  @map("job_id") @db.Text

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  ExportJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([jobId])
  @@map("exports")
}

/// An in-flight (or failed) export job. `finalizing_*` columns are the
/// server-owned finalization lease (schema v14) that fences concurrent
/// completions; `staging_r2_key` is the pre-finalization object.
model ExportJob {
  id              String    @id @db.Text
  userId          String    @map("user_id") @db.Text
  configJson      String    @map("config_json") @db.Text
  status          String    @default("pending") @db.Text
  progress        Int       @default(0)
  resultR2Key     String?   @map("result_r2_key") @db.Text
  resultExportId  String?   @map("result_export_id") @db.Text
  resultFileSize  BigInt?   @default(0) @map("result_file_size")
  errorMessage    String?   @map("error_message") @db.Text
  retryCount      Int       @default(0) @map("retry_count")
  createdAt       DateTime  @map("created_at") @db.Timestamptz(3)
  startedAt       DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(3)
  stagingR2Key    String?   @map("staging_r2_key") @db.Text
  finalizingAt    DateTime? @map("finalizing_at") @db.Timestamptz(3)
  finalizingToken String?   @map("finalizing_token") @db.Text

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exports Export[]

  @@index([userId])
  @@index([status])
  @@index([userId, createdAt(sort: Desc)])
  @@map("export_jobs")
}

/// Fulfilment claim. One row per paid order: whichever caller (webhook or
/// return-trip verify) inserts it first owns the plan write. Idempotency is a
/// primary-key conflict, not an application check.
model ProcessedWebhook {
  orderId     String   @id @map("order_id") @db.Text
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@map("processed_webhooks")
}

/// A checkout order and its lifecycle. `amount` is money and must never be
/// floating point.
///
/// `status` is the authority: only `creating`/`open`/`termination_requested`
/// are live checkouts, and a partial unique index (SQL only — Prisma cannot
/// express it) allows at most one of those per user. `held_review` is a
/// fulfilment obligation kept outside that index, so a late payment can be
/// recorded while another checkout is still live. The timestamps and reasons
/// are cross-checked by CHECK constraints in the migration; Prisma does not
/// model those, so `prisma migrate dev`/`db push` must never be run against a
/// database that carries this schema.
model PendingOrder {
  orderId           String    @id @map("order_id") @db.Text
  userId            String    @map("user_id") @db.Text
  plan              String    @db.Text
  amount            Decimal   @db.Decimal(12, 2)
  currency          String    @default("INR") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  status            String    @default("open") @db.Text
  closedAt          DateTime? @map("closed_at") @db.Timestamptz(3)
  closeReason       String?   @map("close_reason") @db.Text
  heldAt            DateTime? @map("held_at") @db.Timestamptz(3)
  holdReason        String?   @map("hold_reason") @db.Text
  fulfilledAt       DateTime? @map("fulfilled_at") @db.Timestamptz(3)
  lastCheckedAt     DateTime? @map("last_checked_at") @db.Timestamptz(3)
  probeCount        Int       @default(0) @map("probe_count")
  firstProbedAt     DateTime? @map("first_probed_at") @db.Timestamptz(3)
  terminationSentAt DateTime? @map("termination_requested_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, createdAt])
  @@map("pending_orders")
}

/// Per-user checkout mutex, held across reconciliation and order reservation so
/// two concurrent checkouts cannot both decide that no earlier order needs
/// reconciling. Rows are ephemeral: `locked_at` is a TTL, so a crashed holder
/// releases itself. No FK — the row is deleted by the next holder, not by the
/// account-deletion path.
model CheckoutLock {
  userId   String   @id @map("user_id") @db.Text
  token    String   @db.Text
  lockedAt DateTime @default(now()) @map("locked_at") @db.Timestamptz(3)

  @@map("checkout_locks")
}

/// Per-user, per-UTC-month export counter (atomic check-and-increment).
model MonthlyExportCount {
  userId String @map("user_id") @db.Text
  period String @db.Text
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, period])
  @@map("monthly_export_counts")
}

/// Per-user, per-UTC-day recorded-seconds ledger (atomic budget enforcement).
model DailyRecordingSecond {
  userId  String @map("user_id") @db.Text
  day     String @db.Text
  seconds Float  @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("daily_recording_seconds")
}

/// Post-payment notification ledger, keyed by (order, kind), so a receipt is
/// sent exactly once independently of who fulfilled the order.
model OrderNotification {
  orderId String   @map("order_id") @db.Text
  kind    String   @db.Text
  sentAt  DateTime @default(now()) @map("sent_at") @db.Timestamptz(3)

  @@id([orderId, kind])
  @@map("order_notifications")
}

/// Identity tombstone for account deletion: the highest session version ever
/// issued for a deleted address, so a re-registration starts above it and
/// retires every JWT minted for the previous identity.
model DeletedIdentity {
  email          String   @id @db.Text
  sessionVersion Int      @map("session_version")
  deletedAt      DateTime @default(now()) @map("deleted_at") @db.Timestamptz(3)

  @@map("deleted_identities")
}

// NOTE: Prisma Migrate (prisma/migrations + the _prisma_migrations table) is the
// single schema authority. `schema_meta` IS modelled above (see SchemaMeta) only
// because the current `/api/health` reads it — it is a data table, not a migration
// runner, and no runtime code will write it once the data layer is ported.
