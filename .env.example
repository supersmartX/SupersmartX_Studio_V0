# =============================================================================
# SupersmartX Studio - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Official community invite opened by the sidebar "Discord Community" entry and
# the post-download engagement popup. Optional: when unset, both fall back to
# the published invite so a link is never rendered empty.
# NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/supersmartx

# -----------------------------------------------------------------------------
# NextAuth
# -----------------------------------------------------------------------------
# src/auth.ts accepts EITHER name for the same secret: NEXTAUTH_SECRET
# (NextAuth default) or the framework alias AUTH_SECRET â€” at least one must
# be set, or production fails closed at boot with "[AUTH] NEXTAUTH_SECRET is
# not set". Set one, or both to the same value if your host injects aliases.
NEXTAUTH_SECRET=generate-a-strong-random-secret-here-min-32-chars
# AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Google OAuth (optional)
# -----------------------------------------------------------------------------
# NOTE (Phase 5 / F-08): an older NEXT_PUBLIC_GOOGLE_AUTH=true/false gate is
# not read anywhere in the code â€” it is dead. The Google provider is
# registered if and only if BOTH values below are non-empty (src/auth.ts),
# and the sign-in UI shows the Google button when the provider exists.
# Leave both empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Cashfree Payments
# -----------------------------------------------------------------------------
CASHFREE_APP_ID=
# PG client secret key. Also the webhook-signing key: Cashfree signs every
# webhook with this exact value and publishes no separate webhook secret, so
# this is the only secret the payment path reads. /api/cashfree/webhook
# rejects any request whose HMAC it cannot reproduce with it.
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2022-09-01
# Isolated local development only. Use a disposable database and Sandbox keys.
# Vercel Production requires BOTH selectors to be production and matching
# Production credentials. Missing/invalid config fails the Production build
# and every payment path. NODE_ENV=production alone is not a Vercel deployment.
CASHFREE_ENV=sandbox
NEXT_PUBLIC_CASHFREE_ENV=sandbox
# Environment is bound to the build: never promote a Sandbox artifact to Production.
# NEXT_PUBLIC_CASHFREE_PRODUCTION_ONLY and CASHFREE_BUILD_ENV are derived by
# next.config.ts; do not set them manually. Credentials never enter browser code.

# -----------------------------------------------------------------------------
# Resend Email (optional)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# Database (PostgreSQL via Supabase + Prisma)
# -----------------------------------------------------------------------------
# Required in all environments. Local development points at a disposable
# Supabase/Postgres database; production uses the production Supabase project.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Used by `prisma migrate` (and the Stage 4 migration tooling) for DDL.
DIRECT_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# -----------------------------------------------------------------------------
# Cloudflare R2 Storage (optional)
# -----------------------------------------------------------------------------
# Server-only. Never expose these to the browser: the exported MP4 is uploaded
# with a short-lived presigned URL, so the browser never needs a credential.
# Do NOT create NEXT_PUBLIC_R2_SECRET / NEXT_PUBLIC_R2_ACCESS_KEY.
# The bucket must also allow the browser PUT â€” see DEPLOYMENT.md Â§1
# "Cloudflare R2 bucket CORS (required for Creator export)".
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_SIGNED_URL_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
# Shared secret for the nightly export-job cleanup route.
# Vercel Cron Jobs authenticate with `Authorization: Bearer $CRON_SECRET`, and
# this route compares that value against CLEANUP_SECRET â€” so set CRON_SECRET to
# the SAME value, or the scheduled sweep gets 401 and never runs.
# Manual runs may send the value as `x-cleanup-secret: <value>` instead.
# CLEANUP_SECRET=generate-a-random-secret-for-cleanup-endpoint
#
# Separate secret for the billing operations route
# (GET|POST /api/internal/billing/orders): it can release a PAID-but-unapplied
# order, so it must NOT reuse CLEANUP_SECRET. Unset -> the route answers 503
# (fail closed). Send as `Authorization: Bearer <value>` or
# `x-billing-ops-secret: <value>`.
# BILLING_OPS_SECRET=generate-a-different-random-secret-for-billing-ops
# ADMIN_EMAIL=

# -----------------------------------------------------------------------------
# Monitoring (optional)
# -----------------------------------------------------------------------------
# DISCORD_WEBHOOK_URL=
