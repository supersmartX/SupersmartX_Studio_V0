# =============================================================================
# SupersmartX Studio - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# NextAuth
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=generate-a-strong-random-secret-here-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Google OAuth (optional — set NEXT_PUBLIC_GOOGLE_AUTH=true to enable)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_AUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Cashfree Payments
# -----------------------------------------------------------------------------
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01
# Server-side environment. In production this MUST be exactly "production":
# any other value (unset, misspelt, empty) makes every payment path refuse to
# run rather than fall back to sandbox.
CASHFREE_ENV=sandbox
NEXT_PUBLIC_CASHFREE_ENV=sandbox
# Webhook signing secret from the Cashfree dashboard (Dashboard → Webhooks →
# Secret). This is NOT the API secret key. Without it, /api/cashfree/webhook
# falls back to CASHFREE_SECRET_KEY and rejects every genuine Cashfree event,
# so a paid order is never activated by webhook.
CASHFREE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Resend Email (optional)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Database (SQLite via Turso/libSQL)
# -----------------------------------------------------------------------------
# Local development (default): uses data/supersmartx.db — no env vars needed
# Production / Vercel: set TURSO_DATABASE_URL and TURSO_AUTH_TOKEN
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-auth-token

# -----------------------------------------------------------------------------
# Cloudflare R2 Storage (optional)
# -----------------------------------------------------------------------------
# Server-only. Never expose these to the browser: the exported MP4 is uploaded
# with a short-lived presigned URL, so the browser never needs a credential.
# Do NOT create NEXT_PUBLIC_R2_SECRET / NEXT_PUBLIC_R2_ACCESS_KEY.
# The bucket must also allow the browser PUT — see DEPLOYMENT.md §2
# "Cloudflare R2 bucket CORS (required)".
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_SIGNED_URL_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
# Shared secret for the nightly export-job cleanup route.
# Vercel Cron Jobs authenticate with `Authorization: Bearer $CRON_SECRET`, and
# this route compares that value against CLEANUP_SECRET — so set CRON_SECRET to
# the SAME value, or the scheduled sweep gets 401 and never runs.
# Manual runs may send the value as `x-cleanup-secret: <value>` instead.
# CLEANUP_SECRET=generate-a-random-secret-for-cleanup-endpoint
# ADMIN_EMAIL=

# -----------------------------------------------------------------------------
# Monitoring (optional)
# -----------------------------------------------------------------------------
# DISCORD_WEBHOOK_URL=
