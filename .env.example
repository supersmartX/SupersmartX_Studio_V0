# =============================================================================
# SupersmartX Studio - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# NextAuth
# -----------------------------------------------------------------------------
# src/auth.ts accepts EITHER name for the same secret: NEXTAUTH_SECRET
# (NextAuth default) or the framework alias AUTH_SECRET — at least one must
# be set, or production fails closed at boot with "[AUTH] NEXTAUTH_SECRET is
# not set". Set one, or both to the same value if your host injects aliases.
NEXTAUTH_SECRET=generate-a-strong-random-secret-here-min-32-chars
# AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Google OAuth (optional)
# -----------------------------------------------------------------------------
# NOTE (Phase 5 / F-08): an older NEXT_PUBLIC_GOOGLE_AUTH=true/false gate is
# not read anywhere in the code — it is dead. The Google provider is
# registered if and only if BOTH values below are non-empty (src/auth.ts),
# and the sign-in UI shows the Google button when the provider exists.
# Leave both empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Cashfree Payments
# -----------------------------------------------------------------------------
CASHFREE_APP_ID=
# PG client secret key. Also the webhook-signing key: Cashfree signs every
# webhook with this exact value and publishes no separate webhook secret, so
# this is the only secret the payment path reads. /api/cashfree/webhook
# rejects any request whose HMAC it cannot reproduce with it.
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01
# Which Cashfree environment the payment path talks to. Exactly one of:
#   sandbox    -> Cashfree Sandbox
#   production -> Cashfree Production
# This is the single source of truth and is deliberately independent of
# NODE_ENV: a production deployment may deliberately use Sandbox while testing.
# Any other value — unset, empty, misspelt, wrong case — makes every payment
# path refuse to run. Nothing is ever substituted: an unknown value fails
# closed rather than quietly becoming sandbox.
CASHFREE_ENV=sandbox
# Build-time mirror of the above, baked into the browser bundle. It must equal
# CASHFREE_ENV exactly; a mismatch fails closed at order creation, because
# checkout would otherwise render in one environment while the order and its
# webhook live in the other. Because it is baked in, switching environments
# requires a rebuild (Vercel: redeploy), not just changing the variable.
NEXT_PUBLIC_CASHFREE_ENV=sandbox

# -----------------------------------------------------------------------------
# Resend Email (optional)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Database (SQLite via Turso/libSQL)
# -----------------------------------------------------------------------------
# Local development (default): uses data/supersmartx.db — no env vars needed
# Production / Vercel: set TURSO_DATABASE_URL and TURSO_AUTH_TOKEN
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-auth-token

# -----------------------------------------------------------------------------
# Cloudflare R2 Storage (optional)
# -----------------------------------------------------------------------------
# Server-only. Never expose these to the browser: the exported MP4 is uploaded
# with a short-lived presigned URL, so the browser never needs a credential.
# Do NOT create NEXT_PUBLIC_R2_SECRET / NEXT_PUBLIC_R2_ACCESS_KEY.
# The bucket must also allow the browser PUT — see DEPLOYMENT.md §1
# "Cloudflare R2 bucket CORS (required for Creator export)".
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_SIGNED_URL_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
# Shared secret for the nightly export-job cleanup route.
# Vercel Cron Jobs authenticate with `Authorization: Bearer $CRON_SECRET`, and
# this route compares that value against CLEANUP_SECRET — so set CRON_SECRET to
# the SAME value, or the scheduled sweep gets 401 and never runs.
# Manual runs may send the value as `x-cleanup-secret: <value>` instead.
# CLEANUP_SECRET=generate-a-random-secret-for-cleanup-endpoint
# ADMIN_EMAIL=

# -----------------------------------------------------------------------------
# Monitoring (optional)
# -----------------------------------------------------------------------------
# DISCORD_WEBHOOK_URL=
